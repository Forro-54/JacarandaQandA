IF NOT EXISTS (
    SELECT 1 FROM sys.objects
    WHERE object_id = OBJECT_ID(N'{databaseOwner}[{objectQualifier}JacarandaQAPortalSettings]')
      AND type = N'U'
)
BEGIN
    CREATE TABLE {databaseOwner}[{objectQualifier}JacarandaQAPortalSettings] (
        [PortalId] INT NOT NULL,
        [PostingEnabled] BIT NOT NULL CONSTRAINT [DF_{objectQualifier}JQAPS_Posting] DEFAULT ((1)),
        [GuestPostingEnabled] BIT NOT NULL CONSTRAINT [DF_{objectQualifier}JQAPS_Guests] DEFAULT ((0)),
        [RequireRegisteredModeration] BIT NOT NULL CONSTRAINT [DF_{objectQualifier}JQAPS_RegMod] DEFAULT ((1)),
        [EnableLanguageFilter] BIT NOT NULL CONSTRAINT [DF_{objectQualifier}JQAPS_Language] DEFAULT ((0)),
        [BlockedLanguageTerms] NVARCHAR(MAX) NULL,
        [MaximumQuestionLength] INT NOT NULL CONSTRAINT [DF_{objectQualifier}JQAPS_QMax] DEFAULT ((4000)),
        [MaximumResponseLength] INT NOT NULL CONSTRAINT [DF_{objectQualifier}JQAPS_RMax] DEFAULT ((4000)),
        [EnableRateLimiting] BIT NOT NULL CONSTRAINT [DF_{objectQualifier}JQAPS_Rate] DEFAULT ((1)),
        [RateLimitSeconds] INT NOT NULL CONSTRAINT [DF_{objectQualifier}JQAPS_RateSeconds] DEFAULT ((60)),
        [RateLimitMaxPosts] INT NOT NULL CONSTRAINT [DF_{objectQualifier}JQAPS_RatePosts] DEFAULT ((5)),
        [RateLimitWindowMinutes] INT NOT NULL CONSTRAINT [DF_{objectQualifier}JQAPS_RateWindow] DEFAULT ((15)),
        [EnableCaptcha] BIT NOT NULL CONSTRAINT [DF_{objectQualifier}JQAPS_Captcha] DEFAULT ((0)),
        [EnableNotifications] BIT NOT NULL CONSTRAINT [DF_{objectQualifier}JQAPS_Notify] DEFAULT ((0)),
        [NotificationEmailAddresses] NVARCHAR(2000) NULL,
        [IncludeSubmissionTextInNotifications] BIT NOT NULL CONSTRAINT [DF_{objectQualifier}JQAPS_NotifyText] DEFAULT ((1)),
        [ModifiedOnDate] DATETIME NULL,
        [ModifiedByUserId] INT NULL,
        CONSTRAINT [PK_{objectQualifier}JacarandaQAPortalSettings] PRIMARY KEY CLUSTERED ([PortalId] ASC)
    );
END
